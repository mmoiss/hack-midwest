# Agent colors for server.ts, the same token table backend/mcp.py reads.
# Values below match the seeded demo agents (backend/seed.py). Keep the quotes: '#' starts a comment.
TEAM_TOKENS='{"tok_alice":{"name":"alice","color":"#c8794a"},"tok_bob":{"name":"bob","color":"#7a9a6e"},"tok_carol":{"name":"carol","color":"#6a86a3"}}'

# Optional. By default the dashboard uses same-origin /api/stream, which the
# Vite dev server serves itself (see vite.config.ts).
# Set this only if the dashboard server lives somewhere else.
# VITE_STREAM_URL=https://your-linode-host/api/stream
