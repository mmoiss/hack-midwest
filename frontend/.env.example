# Agent colors for server.ts, the same token table backend/mcp.py reads.
# Values below match the seeded demo agents (backend/seed.py). Keep the quotes: '#' starts a comment.
TEAM_TOKENS='{"tok_alice":{"name":"alice","color":"#c8794a"},"tok_bob":{"name":"bob","color":"#7a9a6e"},"tok_carol":{"name":"carol","color":"#6a86a3"}}'

# Optional. By default the dashboard uses same-origin /api/stream, which the
# Vite dev server serves itself (see vite.config.ts).
# Set this only if the dashboard server lives somewhere else.
# VITE_STREAM_URL=https://your-linode-host/api/stream

# Optional. Where server.ts reads the coordinator's SQLite file from. Must point at the
# exact same file backend/mcp.py is writing to -- if you set DB_PATH in the repo-root
# .env for a local run, set it to the same value here too. Unset, both now default to
# <repo-root>/coordinator.db -- see #13.
# DB_PATH=../coordinator.db

# Optional. Where the Vite dev server proxies the dashboard's human-decision routes
# (/api/proposals/{id}, /api/alerts/{id}/resolve) -- the Python server, `python -m backend.mcp`.
# In production Caddy routes /api/* to it, so nothing to set there.
# BACKEND_URL=http://localhost:8000

# Optional. Only if the browser should POST decisions to a different origin than the one
# serving the page (the Python server has no CORS today, so leave unset unless you add it).
# VITE_API_URL=https://your-linode-host
