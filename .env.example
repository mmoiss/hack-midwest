# Copy to .env, here and on the VM. .env is gitignored; never commit the real one.

# The hostname Caddy issues a TLS certificate for.
# sslip.io needs no registration and no DNS record: the name encodes the IP, so
# 203-0-113-5.sslip.io already resolves to 203.0.113.5. Put your Linode's public IP
# here with dashes instead of dots. Swap in a real domain later by editing this line.
DOMAIN=203-0-113-5.sslip.io

# token -> {name, color}, one entry per teammate. The token is both auth and identity.
# Generate with:  python scripts/make_tokens.py alice bob carol
# Single-quoted so the '#' in the hex colors is not read as a comment.
TEAM_TOKENS='{"replace-me":{"name":"alice","color":"#e06c75"}}'

# Coordinator inference (backend/coordinator.py). The team key stays on the VM.
# COORDINATOR_MODEL_PROVIDER picks the provider: akamai (default), anthropic, openai, ollama.
# Swapping it is SPEC.md's stated fallback for flaky tool calling.
COORDINATOR_MODEL_PROVIDER=akamai
AKAMAI_TEAM_KEY=
AKAMAI_BASE_URL=https://ws.akamai-workshops.com/v1

# Where backend/mcp.py's SQLite file lives. Docker ignores this -- compose.yaml pins
# DB_PATH to /app/data/coordinator.db for the `app` service directly. This only matters
# for a local/laptop run (python -m backend.mcp side by side with the dashboard's
# `npm run server`), and frontend/.env.example's DB_PATH must be set to the same path.
# Unset, both now default to the same place (<repo-root>/coordinator.db) -- see #13.
# DB_PATH=./coordinator.db
