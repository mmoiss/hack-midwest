# Copy to .env (gitignored, never commit the real one) for your own reference, then
# export these into your shell before running `claude` or `codex` here -- Claude Code
# and Codex do NOT read .env files themselves; they only see what's already in the
# process environment when they start. This file is just a place to keep the values
# straight, not something either CLI auto-loads.
#
#   set -a; source .env; set +a      # bash/zsh
#   Get-Content .env | ForEach-Object { if ($_ -match '^([^=]+)=(.*)$') { Set-Item "env:$($matches[1])" $matches[2] } }   # PowerShell

# Your own bearer token. Ask whoever owns the Server track for a real one; any
# placeholder works against the local mock (hooks/mock_events_server.py).
CLAUDE_TEAM_TOKEN=
CODEX_TEAM_TOKEN=

# .mcp.json's `url` and .codex/config.toml both read these. Point at the local
# server by default; swap to the real deployed URL to rehearse against production --
# never hand-edit .mcp.json itself to do this, that's how a real token+URL ended up
# hardcoded in a tracked file before.
TEAM_MCP_URL=http://localhost:8000/mcp
TEAM_EVENTS_URL=http://localhost:8000/events
