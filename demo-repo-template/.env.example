# Copy this file to .env (gitignored) and fill in YOUR token. Then:
#
#   ./demo.sh up        (Git Bash / macOS / Linux)        .\demo.ps1 up        (PowerShell)
#   ./demo.sh reset                                        .\demo.ps1 reset
#   ./demo.sh status                                       .\demo.ps1 status
#
# The launcher loads this file itself, so there is nothing to export and no config file to
# edit. (Claude Code and Codex do not read .env on their own; the launcher is what makes
# these values reach them.)

# Your own bearer token, from whoever owns the server. Set the one for the CLI you use; if
# both are set, `demo up claude` / `demo up codex` picks.
CLAUDE_TEAM_TOKEN=
CODEX_TEAM_TOKEN=

# The server. These are the live Akamai VM; for a laptop-local server use
# http://127.0.0.1:8000/mcp and http://127.0.0.1:8000/events.
TEAM_MCP_URL=https://172-237-146-90.sslip.io/mcp
TEAM_EVENTS_URL=https://172-237-146-90.sslip.io/events
