# While you are still getting compose to come up, uncomment this block to use Let's
# Encrypt's STAGING CA. Certs are untrusted (browsers warn, curl needs -k) but issuance
# is effectively unlimited. Production issuance is rate limited per hostname, and burning
# it locks this name out of new certs for a week — which you do not want to discover at
# 6 AM. Comment it back out for the real demo, then `docker compose restart caddy`.
#
# {
# 	acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
# }

{$DOMAIN} {
	# `app` and `dashboard` are compose service names; Docker's internal DNS resolves
	# them. Caddy terminates TLS here and speaks plain HTTP over the private network.

	# The Python server owns these three paths.
	handle /mcp* {
		reverse_proxy app:8000 {
			# MCP streamable HTTP answers POSTs with text/event-stream; stream it like
			# /api/stream rather than buffering. (If an agent cannot connect from a laptop
			# while curl from the VM works, suspect TLS inspection on that laptop, not this:
			# see INTEGRATION.md, "Antivirus HTTPS scanning breaks MCP".)
			flush_interval -1
		}
	}
	handle /events {
		reverse_proxy app:8000
	}
	handle /health {
		reverse_proxy app:8000
	}

	# The dashboard's Server-Sent Events feed — the only route server.ts serves.
	handle /api/stream {
		reverse_proxy dashboard:3001 {
			# SSE must not be buffered: -1 flushes every write straight through, so
			# events reach the browser as they happen instead of pooling until the
			# response ends (which, for a stream, is never).
			flush_interval -1
		}
	}

	# Human decisions from the dashboard (Accept/Reject a proposal, Mark resolved):
	# /api/proposals/{id} and /api/alerts/{id}/resolve on the Python server, the only
	# SQLite writer. Caddy matches handle blocks longest-path-first, so /api/stream above
	# keeps its own route regardless of order.
	handle /api/* {
		reverse_proxy app:8000
	}

	# Everything else is the built React app, served off disk by Caddy.
	# server.ts deliberately does not serve static files — it 404s anything that is not
	# /api/stream — so nothing would answer here without this block.
	handle {
		root * /srv/dashboard
		# SPA fallback: unknown paths return index.html so client-side routing works
		# instead of 404ing on a refresh.
		try_files {path} /index.html
		file_server
	}
}
